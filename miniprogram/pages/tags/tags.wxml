<page-meta page-style="{{pageFontStyle}}" />
<view class="tags-page-shell" style="{{pageFontStyle}}">
  <navigation-bar title="标签管理" color="#2F3A34" background="transparent"></navigation-bar>

  <view class="page tags-page">
  <view class="section-title">
    <text>共用标签</text>
    <text class="muted">两个人都可使用</text>
  </view>
  <view class="tag-card card">
    <view wx:if="{{sharedTags.length === 0}}" class="tag-empty muted">暂无共用标签</view>
    <view
      wx:for="{{sharedTags}}"
      wx:key="id"
      class="tag-chip-wrap"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      bindtap="onTagTap"
      bindlongpress="onTagLongPress"
    >
      <plan-tag-pill name="{{item.name}}" color="{{item.color}}" text-color="{{item.textColor}}" size="sm" />
    </view>
  </view>

  <view class="section-title">
    <text>私人标签</text>
    <text class="muted">只有自己可见</text>
  </view>
  <view class="tag-card card">
    <view wx:if="{{privateTags.length === 0}}" class="tag-empty muted">暂无私人标签</view>
    <view
      wx:for="{{privateTags}}"
      wx:key="id"
      class="tag-chip-wrap"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      bindtap="onTagTap"
      bindlongpress="onTagLongPress"
    >
      <plan-tag-pill name="{{item.name}}" color="{{item.color}}" text-color="{{item.textColor}}" size="sm" />
    </view>
  </view>

  <button class="add-button primary-button" bindtap="addTag">新增标签</button>
  </view>
</view>

<tag-create-sheet
  visible="{{isTagCreateVisible}}"
  edit-tag="{{editingTag}}"
  pageFontStyle="{{pageFontStyle}}"
  showVisibilityPicker="{{true}}"
  defaultVisibility="shared"
  bind:close="closeTagCreateSheet"
  bind:confirm="onTagCreateConfirm"
  bind:delete="onTagDelete"
/>
