<page-meta page-style="{{pageFontStyle}}" />
<view class="index-page-shell" style="{{pageFontStyle}}">
<navigation-bar extClass="home-nav-bar" title="MyForest" back="{{false}}" color="#609873" background="#FAF9F6">
  <view
    wx:if="{{homeContentVisible}}"
    slot="left"
    class="nav-settings-btn home-reveal-item {{homeRevealActive ? 'home-reveal-delay-1' : 'is-visible'}}"
    bindtap="goSettings"
  >
    <image class="nav-settings-icon" src="/images/icons/setting.svg" mode="aspectFit"></image>
  </view>
</navigation-bar>

<scroll-view class="scroll-page home-scroll" scroll-y="{{!isVoiceMaskVisible && !isAiProcessing && !isAiDraftVisible && !isPickerSheetVisible && !isTagCreateVisible && !isLoginSheetVisible}}" type="list">
  <view class="page home {{needProfileLogin ? 'home-guest' : ''}}">
    <view class="hero">
      <view class="hero-main">
        <view class="hero-date">{{today}}</view>
        <view class="hero-title-row hero-title-row--{{heroAvatarAnimate ? 'animate' : 'static'}} {{heroAvatarExpanded ? 'expanded' : 'guest'}}" bindtap="onHeroGreetingTap">
          <view class="hero-avatar-slot">
            <image wx:if="{{avatarUrl}}" class="hero-avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
          </view>
          <view class="hero-title-wrap">
            <view class="hero-greeting">你好，</view>
            <view class="hero-name {{needProfileLogin ? 'hero-title-login' : ''}}">{{needProfileLogin ? '请登录' : nickname}}</view>
          </view>
        </view>
        <view class="hero-subtitle">今天也慢慢种一棵树</view>
      </view>
      <view class="hero-tree-wrap">
        <image wx:if="{{heroTreeSrc}}" class="hero-tree" src="{{heroTreeSrc}}" mode="aspectFit"></image>
        <view wx:else class="hero-tree hero-tree-fallback" aria-hidden="true">
          <view class="hero-tree-hill"></view>
          <view class="hero-tree-crown"></view>
        </view>
      </view>
    </view>

    <view wx:if="{{homeContentVisible && selfFocusVisible}}" class="companion-live card home-reveal-item {{homeRevealActive ? 'home-reveal-delay-2' : 'is-visible'}}" bindtap="goFocusResume">
      <view class="companion-avatar-wrap">
        <view class="companion-breathe-ring companion-breathe-ring-a"></view>
        <view class="companion-breathe-ring companion-breathe-ring-b"></view>
        <view class="companion-avatar-ring"></view>
        <image class="companion-avatar" src="{{selfFocus.avatarUrl}}" mode="aspectFill"></image>
      </view>
      <view class="companion-live-main">
        <view class="companion-live-title">{{selfFocus.name}}</view>
        <view class="companion-live-desc">{{selfFocus.status}} · {{selfFocus.duration}}</view>
      </view>
    </view>

    <view wx:if="{{homeContentVisible && partnerFocusVisible}}" class="companion-live card home-reveal-item {{homeRevealActive ? 'home-reveal-delay-3' : 'is-visible'}}">
      <view class="companion-avatar-wrap">
        <view class="companion-breathe-ring companion-breathe-ring-a"></view>
        <view class="companion-breathe-ring companion-breathe-ring-b"></view>
        <view class="companion-avatar-ring"></view>
        <image class="companion-avatar" src="{{partner.avatarUrl}}" mode="aspectFill"></image>
      </view>
      <view class="companion-live-main">
        <view class="companion-live-title">{{partner.name}}</view>
        <view class="companion-live-desc">{{partner.status}} · {{partner.duration}}</view>
      </view>
    </view>

    <view wx:if="{{homeContentVisible}}" class="home-section home-reveal-item {{homeRevealActive ? 'home-reveal-delay-2' : 'is-visible'}}">
      <view class="home-section-title">临近计划</view>

      <view wx:if="{{nextPlans.length}}" class="plan-list">
        <view wx:for="{{nextPlans}}" wx:key="id" class="plan-card card" bindtap="goDay">
          <image class="plan-owner-avatar {{item.color}}" src="{{item.ownerAvatarUrl}}" mode="aspectFill"></image>
          <view class="plan-main">
            <view class="plan-title">{{item.title}}</view>
            <view class="plan-meta">{{item.time}} · {{item.hint}}</view>
          </view>
          <view class="plan-status plan-status-{{item.statusClass}}">{{item.statusLabel}}</view>
        </view>
      </view>

      <view wx:else class="plan-empty">今天暂无临近计划</view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{isVoiceMaskVisible}}" class="voice-mask mask-fade {{isVoiceCancelling ? 'cancelling' : ''}} {{isVoiceMaskClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtouchmove="onVoiceMove">
  <view class="voice-panel panel-pop {{isVoiceMaskClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}">
    <view class="mic-circle">
      <view class="mic-head"></view>
      <view class="mic-line"></view>
    </view>
    <view class="wave-row">
      <view class="wave-bar bar-1"></view>
      <view class="wave-bar bar-2"></view>
      <view class="wave-bar bar-3"></view>
      <view class="wave-bar bar-4"></view>
      <view class="wave-bar bar-5"></view>
    </view>
    <view class="record-title">{{isVoiceCancelling ? '松开取消' : (voiceMode === 'refine' ? '正在听修改意见' : '正在听你说计划')}}</view>
    <voice-live-text id="voice-live-text" pageFontStyle="{{pageFontStyle}}" />
    <view class="record-tip">{{isVoiceCancelling ? '回到下方继续录音' : '松开发送，上滑取消'}}</view>
  </view>
</view>

<view wx:if="{{isAiProcessing}}" class="voice-mask ai-processing-mask mask-fade {{isAiProcessingClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtouchmove="noop">
  <view class="voice-panel panel-pop {{isAiProcessingClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}">
    <view class="processing-ring"></view>
    <view class="record-title">{{aiProcessingTitle}}</view>
    <view class="voice-processing-text">{{aiProcessingText}}</view>
    <view class="record-tip">正在整理，请稍候...</view>
  </view>
</view>

<view wx:if="{{isAiDraftVisible}}" class="ai-draft-mask mask-fade {{isAiDraftClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtouchmove="noop">
  <view class="ai-draft-panel panel-pop {{isAiDraftClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="noop">
    <block wx:if="{{!isAiDraftEditVisible}}">
      <view class="ai-draft-header">
        <view>
          <view class="ai-draft-title">确认变更</view>
          <view class="muted">请确认以下计划调整</view>
        </view>
        <view class="ai-draft-close" catchtap="closeAiDraft">×</view>
      </view>

      <scroll-view
        wx:if="{{aiChatMessages.length}}"
        class="ai-chat-thread"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        scroll-with-animation
        scroll-top="{{chatScrollTop}}"
      >
        <view
          wx:for="{{aiChatMessages}}"
          wx:key="id"
          class="ai-chat-row {{item.role === 'user' ? 'is-user' : ''}} {{item.role === 'error' ? 'is-error' : ''}} {{item.role === 'assistant' ? 'is-assistant' : ''}}"
        >
          <view class="ai-chat-bubble">{{item.text}}</view>
        </view>
        <view id="ai-chat-end"></view>
      </scroll-view>

      <view wx:if="{{aiConfirmWarnings.length}}" class="ai-confirm-warnings">
        <view wx:for="{{aiConfirmWarnings}}" wx:key="*this" class="ai-confirm-warning-item">{{item}}</view>
      </view>

      <scroll-view class="ai-draft-list" scroll-y>
        <view
          wx:for="{{aiConfirmCards}}"
          wx:key="id"
          class="ai-confirm-card ai-draft-card {{item.kind === 'delete' ? 'is-delete' : ''}} {{item.kind === 'update' ? 'is-update' : ''}} {{item.kind === 'add' ? 'is-add' : ''}}"
        >
          <view class="ai-confirm-card-glow"></view>
          <view class="ai-confirm-card-inner">
            <block wx:if="{{item.kind === 'update'}}">
              <view class="ai-draft-top-row">
                <view class="ai-draft-meta-row">
                  <plan-tag-pill name="{{item.tag}}" size="sm" />
                </view>
                <view class="ai-draft-card-actions">
                  <view class="ai-draft-icon-btn danger" catchtap="revokeAiConfirmItem" data-id="{{item.id}}" data-kind="{{item.kind}}">
                    <image class="ai-draft-icon" src="/images/icons/delete.svg" mode="aspectFit"></image>
                  </view>
                </view>
              </view>
              <view class="ai-confirm-diff">
                <view
                  wx:for="{{item.diffRows}}"
                  wx:for-item="diff"
                  wx:key="label"
                  class="ai-confirm-diff-row"
                >
                  <view class="ai-confirm-diff-label">{{diff.label}}</view>
                  <view class="ai-confirm-diff-before">{{diff.before}}</view>
                  <view class="ai-confirm-diff-arrow">→</view>
                  <view class="ai-confirm-diff-after {{diff.changed ? 'is-changed' : ''}}">{{diff.after}}</view>
                </view>
              </view>
            </block>

            <block wx:else>
              <view class="ai-draft-top-row">
                <view class="ai-draft-meta-row">
                  <plan-tag-pill name="{{item.tag}}" size="sm" />
                  <view class="ai-draft-date">{{item.dateLabel}}</view>
                  <view class="ai-draft-time">{{item.timeLabel}}</view>
                </view>
                <view class="ai-draft-card-actions">
                  <view class="ai-draft-icon-btn danger" catchtap="revokeAiConfirmItem" data-id="{{item.id}}" data-kind="{{item.kind}}">
                    <image class="ai-draft-icon" src="/images/icons/delete.svg" mode="aspectFit"></image>
                  </view>
                </view>
              </view>
              <view wx:if="{{item.sourceLabel}}" class="ai-confirm-source">{{item.sourceLabel}}</view>
              <view class="ai-draft-remark">{{item.remark}}</view>
            </block>
          </view>
        </view>
      </scroll-view>

      <view class="ai-draft-actions">
        <button
          class="ai-draft-action-button secondary-button {{isRecording && voiceMode === 'refine' ? 'recording' : ''}}"
          bindtouchstart="onDraftRefineVoiceStart"
          bindtouchend="onDraftRefineVoiceEnd"
          bindtouchcancel="onDraftRefineVoiceCancel"
          catchtouchmove="onDraftRefineVoiceMove"
        >
          <view class="ai-draft-action-label">
            <text class="ai-draft-action-title">{{isRecording && voiceMode === 'refine' ? '松开调整' : '继续调整'}}</text>
            <text class="ai-draft-action-subtitle">长按说出修改意见</text>
          </view>
        </button>
        <button
          class="ai-draft-action-button primary-button {{aiConfirmHasDelete ? 'danger' : ''}}"
          bindtap="confirmAiDrafts"
        >
          <text class="ai-draft-action-title">确定</text>
        </button>
      </view>
    </block>

    <block wx:else>
      <view class="ai-draft-header">
        <view>
          <view class="ai-draft-title">编辑计划草稿</view>
          <view class="muted">修改后保存即可更新草稿</view>
        </view>
        <view class="ai-draft-close" catchtap="closeAiDraftEdit">×</view>
      </view>

      <scroll-view class="plan-edit-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="plan-edit-form">
          <block wx:if="{{!singleUserMode}}">
            <view class="plan-form-label">归属成员</view>
            <view class="plan-owner-row">
              <view class="plan-owner-chip {{editPlanForm.ownerKey === 'me' ? 'active' : ''}}" data-owner="me" bindtap="chooseEditPlanOwner">
                <image class="filter-avatar green" src="{{avatarUrl}}" mode="aspectFill"></image>
                <text>我</text>
              </view>
              <view class="plan-owner-chip {{editPlanForm.ownerKey === 'partner' ? 'active' : ''}}" data-owner="partner" bindtap="chooseEditPlanOwner">
                <image class="filter-avatar blue" src="{{partnerAvatarUrl}}" mode="aspectFill"></image>
                <text>{{partnerNickname}}</text>
              </view>
            </view>
          </block>

          <view class="plan-form-label">主题标签</view>
          <view class="tag-scroll-wrap">
            <view class="tag-scroll-fade tag-scroll-fade-left {{showPlanTagScrollFadeLeft ? 'is-visible' : ''}}"></view>
            <scroll-view
              class="tag-scroll"
              scroll-x
              enhanced
              show-scrollbar="{{false}}"
              enable-flex
              bindscroll="onPlanTagScroll"
            >
              <view class="tag-scroll-list">
                <view
                  wx:for="{{quickTags}}"
                  wx:key="id"
                  class="plan-tag-option"
                  data-tag="{{item.name}}"
                  data-tag-id="{{item.id}}"
                  bindtap="chooseEditPlanTag"
                >
                  <plan-tag-pill
                    name="{{item.name}}"
                    color="{{item.color}}"
                    size="md"
                    active="{{editPlanForm.tagId === item.id}}"
                  />
                </view>
              </view>
            </scroll-view>
            <view class="tag-scroll-trail">
              <view class="tag-scroll-fade tag-scroll-fade-right {{showPlanTagScrollFadeRight ? 'is-visible' : ''}}"></view>
              <view class="plan-tag-add" bindtap="openTagCreateSheet">+</view>
            </view>
          </view>

          <view class="plan-form-label">备注</view>
          <textarea class="plan-form-textarea" value="{{editPlanForm.remark}}" data-field="remark" placeholder="补充计划细节" bindinput="onEditPlanInput" />

          <view class="plan-form-label">日期</view>
          <view class="plan-picker-field" bindtap="openDatePicker">
            <text class="plan-picker-value">{{editPlanForm.date}}</text>
            <text class="plan-picker-action">选择日期</text>
          </view>

          <view class="plan-form-label">计划性质</view>
          <view class="schedule-kind-list">
            <view
              wx:for="{{scheduleKindOptions}}"
              wx:key="key"
              class="schedule-kind-card card {{editPlanForm.scheduleKind === item.key ? 'active' : ''}}"
              data-kind="{{item.key}}"
              bindtap="chooseScheduleKind"
            >
              <view class="schedule-kind-title">{{item.title}}</view>
              <view class="schedule-kind-desc">{{item.desc}}</view>
            </view>
          </view>

          <view class="plan-schedule-detail">
          <block wx:if="{{editPlanForm.scheduleKind === 'timed'}}">
            <view class="plan-time-row">
              <view class="plan-time-item">
                <view class="plan-form-label">开始时间</view>
                <view class="plan-picker-field" bindtap="openStartTimePicker">
                  <text class="plan-picker-value plan-picker-value-time">{{editPlanForm.startTime}}</text>
                  <text class="plan-picker-action">选择</text>
                </view>
              </view>
              <view class="plan-time-item">
                <view class="plan-form-label">结束时间</view>
                <view class="plan-picker-field" bindtap="openEndTimePicker">
                  <text class="plan-picker-value plan-picker-value-time">{{editPlanForm.endTime}}</text>
                  <text class="plan-picker-action">选择</text>
                </view>
              </view>
            </view>
          </block>

          <block wx:elif="{{editPlanForm.scheduleKind === 'period'}}">
            <view class="plan-form-label">时段</view>
            <view class="plan-picker-field" bindtap="openPeriodPicker">
              <text class="plan-picker-value">{{periodOptionLabels[editPlanForm.periodIndex]}}</text>
              <text class="plan-picker-action">选择时段</text>
            </view>
          </block>

          <block wx:else>
            <view class="schedule-allday-card card">
              <view class="schedule-allday-title">全天计划</view>
              <view class="schedule-allday-desc">将显示在日计划右侧「全天」列，不占用具体时段。</view>
            </view>
          </block>
          </view>
        </view>
      </scroll-view>

      <view class="ai-draft-actions ai-draft-edit-actions">
        <button class="ai-draft-secondary secondary-button" bindtap="closeAiDraftEdit">返回</button>
        <button class="ai-draft-primary primary-button" bindtap="saveAiDraftEdit">保存修改</button>
      </view>
    </block>
  </view>
</view>

<view wx:if="{{isLoginSheetVisible}}" class="login-sheet-mask mask-fade {{isLoginSheetClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtouchmove="noop" bindtap="closeLoginSheet">
  <view class="login-sheet-panel panel-pop {{isLoginSheetClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="noop">
    <view class="login-sheet-title">完善个人信息</view>
    <view class="login-sheet-desc">邀请码可选，稍后也可加入共享空间</view>
    <view class="login-sheet-form">
      <view class="login-sheet-avatar-wrap">
        <button
          class="login-sheet-avatar-btn"
          type="default"
          open-type="chooseAvatar"
          bindtap="onLoginAvatarButtonTap"
          bindchooseavatar="onChooseLoginAvatar"
        >
          <image wx:if="{{loginAvatarPreviewUrl}}" class="login-sheet-avatar" src="{{loginAvatarPreviewUrl}}" mode="aspectFill"></image>
          <view wx:else class="login-sheet-avatar login-sheet-avatar-placeholder">
            <view class="login-sheet-avatar-icon">+</view>
          </view>
        </button>
        <view class="login-sheet-avatar-label">
          {{loginAvatarPreviewUrl ? '重新选择微信头像' : '点击选择微信头像'}}
        </view>
      </view>
      <input
        class="login-sheet-field"
        type="nickname"
        placeholder="点击填写昵称"
        value="{{loginNickname}}"
        bindinput="onLoginNicknameInput"
        bindblur="onLoginNicknameInput"
      />
      <input
        class="login-sheet-field login-sheet-invite"
        type="text"
        maxlength="32"
        placeholder="邀请码（选填）"
        value="{{loginInviteCode}}"
        bindinput="onLoginInviteCodeInput"
      />
    </view>
    <view class="login-sheet-actions">
      <button class="login-sheet-cancel" bindtap="closeLoginSheet">取消</button>
      <button class="login-sheet-confirm" loading="{{isProfileSaving}}" disabled="{{isProfileSaving}}" bindtap="onConfirmProfileLogin">确定</button>
    </view>
  </view>
</view>

<view wx:if="{{homeContentVisible}}" class="action-grid home-reveal-item {{homeRevealActive ? 'home-reveal-delay-3' : 'is-visible'}}">
  <button
    class="action-card voice-button {{isRecording ? 'recording' : ''}}"
    bindtouchstart="onVoiceStart"
    bindtouchend="onVoiceEnd"
    bindtouchcancel="onVoiceCancel"
    catchtouchmove="onVoiceMove"
  >
    <view class="action-icon action-icon-list"></view>
    <view class="action-copy">
      <view class="action-title">计划表</view>
      <view class="action-subtitle">{{isRecording ? '松开生成计划草稿' : '长按说话让AI生成计划'}}</view>
    </view>
  </button>

  <button class="action-card focus-button" bindtap="goFocus">
    <view class="action-icon action-icon-clock"></view>
    <view class="action-copy">
      <view class="action-title">{{selfFocusVisible ? '回到计时' : '开始计时'}}</view>
      <view class="action-subtitle">{{selfFocusVisible ? '正在专注中' : '正计时专注'}}</view>
    </view>
  </button>
</view>

<view wx:if="{{isPickerSheetVisible}}" class="plan-picker-sheet-mask mask-fade {{isPickerSheetClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="closePickerSheet" catchtouchmove="noop">
  <view class="plan-picker-sheet panel-pop {{isPickerSheetClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="noop">
    <view class="plan-picker-sheet-header">
      <text class="plan-picker-sheet-btn" bindtap="closePickerSheet">取消</text>
      <text class="plan-picker-sheet-title">{{pickerSheetTitle}}</text>
      <text class="plan-picker-sheet-btn confirm" bindtap="confirmPickerSheet">确定</text>
    </view>

    <picker-view
      wx:if="{{pickerSheetKind === 'date'}}"
      class="plan-picker-wheel"
      style="{{pageFontStyle}}"
      value="{{pickerTempValue}}"
      bindchange="onPickerSheetChange"
      indicator-class="plan-picker-indicator"
    >
      <picker-view-column>
        <view wx:for="{{pickerYears}}" wx:key="*this" class="plan-picker-option">{{item}}年</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{pickerMonths}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{pickerDayOptions}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
    </picker-view>

    <picker-view
      wx:elif="{{pickerSheetKind === 'time-start' || pickerSheetKind === 'time-end'}}"
      class="plan-picker-wheel"
      style="{{pageFontStyle}}"
      value="{{pickerTempValue}}"
      bindchange="onPickerSheetChange"
      indicator-class="plan-picker-indicator"
    >
      <picker-view-column>
        <view wx:for="{{pickerHours}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{pickerMinutes}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
    </picker-view>

    <picker-view
      wx:else
      class="plan-picker-wheel"
      style="{{pageFontStyle}}"
      value="{{pickerTempValue}}"
      bindchange="onPickerSheetChange"
      indicator-class="plan-picker-indicator"
    >
      <picker-view-column>
        <view wx:for="{{periodOptionLabels}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>
</view>

<tag-create-sheet visible="{{isTagCreateVisible}}" pageFontStyle="{{pageFontStyle}}" bind:close="closeTagCreateSheet" bind:confirm="onTagCreateConfirm" />
</view>
