<page-meta page-style="{{pageFontStyle}}" />
<view class="day-page-shell" style="{{pageFontStyle}}">
<template name="planCard">
  <view class="schedule-card {{isTimed ? 'is-timed' : ''}}">
    <view class="schedule-card-inner">
      <view wx:if="{{showTime && plan.time}}" class="schedule-card-time">{{plan.time}}</view>
      <view class="schedule-card-meta">
        <image class="schedule-card-avatar {{plan.color}}" src="{{plan.ownerAvatarUrl}}" mode="aspectFill"></image>
        <plan-tag-pill name="{{plan.tag}}" size="{{isCompact ? 'xs-compact' : 'xs'}}" />
        <text wx:if="{{showStatus && plan.status && plan.status !== '已完成' && plan.status !== '待开始'}}" class="schedule-card-status {{plan.status === '逾期' ? 'overdue' : ''}}">{{plan.status}}</text>
      </view>
      <view wx:if="{{plan.remark}}" class="schedule-card-remark">{{plan.remark}}</view>
    </view>
    <image wx:if="{{plan.status === '已完成'}}" class="schedule-card-leaf" src="/images/icons/card-leaf-deco.png" mode="aspectFit"></image>
  </view>
</template>

<view class="timeline-fixed-header" style="padding-top: {{safeTopPx}}px;">
  <view class="page-top-header day-date-back" bindtap="goBack">
    <view class="page-top-title">{{dateTitle}}</view>
    <view class="muted">时间轴 · 时段 · 全天</view>
  </view>
</view>

<scroll-view
  class="scroll-page day-scroll"
  style="{{pageFontStyle}}"
  scroll-y="{{!isPlanActionVisible}}"
  type="list"
  scroll-top="{{scrollWithTop ? scrollTop : ''}}"
  scroll-with-animation="{{false}}"
>
  <view class="page day-page timeline-scroll-wrap {{boardVisible ? 'is-visible' : ''}}" style="padding-top: calc({{safeTopPx}}px + 112rpx);">
    <owner-filter-bar filters="{{filters}}" activeFilter="{{activeFilter}}" bind:change="setFilter" />

    <view class="board-header-row">
      <view class="board-header-spacer"></view>
      <view class="board-header-col col-timed">具体时段</view>
      <view class="board-header-col col-period">上午/下午/晚上</view>
      <view class="board-header-col col-allday">全天</view>
    </view>

    <view class="day-board" style="height: {{boardHeight}}rpx;">
      <view class="timeline-axis" style="height: {{boardHeight}}rpx;">
        <view
          wx:for="{{timelineMarkers}}"
          wx:key="label"
          class="timeline-marker"
          style="top: {{item.top}}rpx;"
        >
          <view class="timeline-dot"></view>
          <text class="timeline-label">{{item.label}}</text>
        </view>
        <view class="timeline-line"></view>
      </view>

      <view
        wx:if="{{nowCursor.visible}}"
        class="timeline-now"
        style="top: {{nowCursor.top}}rpx;"
      >
        <view class="timeline-now-axis">
          <view class="timeline-now-dot"></view>
          <text class="timeline-now-label">{{nowCursor.label}}</text>
        </view>
        <view class="timeline-now-line"></view>
      </view>

      <view class="board-column col-timed">
        <view class="column-body timed-body" style="height: {{boardHeight}}rpx;">
          <view
            wx:for="{{timedPlans}}"
            wx:key="id"
            class="board-card card timed-card {{item.isExpired ? 'expired' : item.color}} {{item.isCompact ? 'timed-card-compact' : ''}}"
            style="top: {{item.top}}rpx; height: {{item.height}}rpx; left: {{item.leftPercent}}%; width: {{item.widthPercent}}%;"
            hover-class="board-card-active"
            data-id="{{item.id}}"
            bindtap="onPlanTap"
          >
            <template is="planCard" data="{{plan: item, showTime: true, showStatus: true, isTimed: true, isCompact: item.isCompact}}" />
          </view>
          <view wx:if="{{timedPlans.length === 0}}" class="column-empty">无</view>
        </view>
      </view>

      <view class="board-column col-period">
        <view class="column-body period-body" style="height: {{boardHeight}}rpx;">
          <view
            class="period-zone morning-zone"
            style="top: {{morningZone.top}}rpx; height: {{morningZone.height}}rpx;"
          >
            <view class="period-zone-label">上午</view>
            <view class="period-cards">
              <view
                wx:for="{{morningPlans}}"
                wx:key="id"
                class="board-card card period-card {{item.isExpired ? 'expired' : item.color}}"
                hover-class="board-card-active"
                data-id="{{item.id}}"
                bindtap="onPlanTap"
              >
                <template is="planCard" data="{{plan: item, showTime: false, showStatus: true}}" />
              </view>
            </view>
          </view>

          <view
            class="period-zone afternoon-zone"
            style="top: {{afternoonZone.top}}rpx; height: {{afternoonZone.height}}rpx;"
          >
            <view class="period-zone-label">下午</view>
            <view class="period-cards">
              <view
                wx:for="{{afternoonPlans}}"
                wx:key="id"
                class="board-card card period-card {{item.isExpired ? 'expired' : item.color}}"
                hover-class="board-card-active"
                data-id="{{item.id}}"
                bindtap="onPlanTap"
              >
                <template is="planCard" data="{{plan: item, showTime: false, showStatus: true}}" />
              </view>
            </view>
          </view>

          <view
            class="period-zone evening-zone"
            style="top: {{eveningZone.top}}rpx; height: {{eveningZone.height}}rpx;"
          >
            <view class="period-zone-label">晚上</view>
            <view class="period-cards">
              <view
                wx:for="{{eveningPlans}}"
                wx:key="id"
                class="board-card card period-card {{item.isExpired ? 'expired' : item.color}}"
                hover-class="board-card-active"
                data-id="{{item.id}}"
                bindtap="onPlanTap"
              >
                <template is="planCard" data="{{plan: item, showTime: false, showStatus: true}}" />
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="board-column col-allday">
        <view class="column-body allday-body" style="height: {{boardHeight}}rpx;">
          <view class="allday-cards">
            <view
              wx:for="{{allDayPlans}}"
              wx:key="id"
              class="board-card card allday-card {{item.isExpired ? 'expired' : item.color}}"
              hover-class="board-card-active"
              data-id="{{item.id}}"
              bindtap="onPlanTap"
            >
              <template is="planCard" data="{{plan: item, showTime: false, showStatus: true}}" />
            </view>
            <view wx:if="{{allDayPlans.length === 0}}" class="column-empty">无</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{isPlanActionVisible && activePlan}}" class="plan-action-mask mask-fade {{isPlanActionClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="closePlanAction" catchtouchmove="noop">
  <view class="plan-action-panel panel-pop {{isPlanActionClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="noop">
    <view class="plan-action-close" catchtap="closePlanAction">×</view>

    <block wx:if="{{!isPlanEditVisible}}">
      <view class="plan-action-title">{{activePlan.title || activePlan.tag}}</view>
      <view class="plan-action-subtitle muted">计划详情</view>

      <view class="plan-detail-card">
        <view class="plan-detail-time-row">
          <image class="plan-detail-time-icon" src="/images/icons/timer.svg" mode="aspectFit"></image>
          <text class="plan-detail-time">{{activePlan.time || '全天'}}</text>
          <text wx:if="{{activePlan.status && activePlan.status !== '待开始'}}" class="plan-detail-status {{activePlan.status === '逾期' ? 'overdue' : ''}}">{{activePlan.status}}</text>
        </view>
        <view class="plan-detail-meta">
          <image class="plan-detail-avatar {{activePlan.color}}" src="{{activePlan.ownerAvatarUrl}}" mode="aspectFill"></image>
          <plan-tag-pill name="{{activePlan.tag}}" size="sm" />
          <text class="plan-detail-owner">{{activePlan.owner}}</text>
        </view>
        <view wx:if="{{activePlan.remark}}" class="plan-detail-note">{{activePlan.remark}}</view>
      </view>

      <view class="plan-action-actions">
        <button class="plan-action-primary primary-button" bindtap="startPlanFocus">
          <image class="plan-action-btn-icon" src="/images/icons/timer-white.svg" mode="aspectFit"></image>
          <text>开始计时</text>
        </button>

        <view class="plan-action-quick-row">
          <button class="plan-action-quick-item" hover-class="plan-action-quick-item-active" bindtap="openPlanEdit">
            <view class="plan-action-quick-icon">
              <image class="plan-action-quick-icon-image" src="/images/icons/edit.svg" mode="aspectFit"></image>
            </view>
            <text class="plan-action-quick-label">编辑计划</text>
          </button>
          <button class="plan-action-quick-item" hover-class="plan-action-quick-item-active" bindtap="completeActivePlan">
            <view class="plan-action-quick-icon">
              <image class="plan-action-quick-icon-image" src="/images/icons/check.svg" mode="aspectFit"></image>
            </view>
            <text class="plan-action-quick-label">标记完成</text>
          </button>
          <button class="plan-action-quick-item danger" hover-class="plan-action-quick-item-active" bindtap="deleteActivePlan">
            <view class="plan-action-quick-icon danger">
              <image class="plan-action-quick-icon-image" src="/images/icons/delete.svg" mode="aspectFit"></image>
            </view>
            <text class="plan-action-quick-label">删除计划</text>
          </button>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="plan-action-title">编辑计划</view>
      <view class="plan-action-subtitle muted">修改后保存即可更新日计划</view>

      <scroll-view class="plan-edit-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="plan-edit-form">
          <block wx:if="{{!singleUserMode}}">
            <view class="plan-form-label">归属成员</view>
            <view class="plan-owner-row">
              <view class="plan-owner-chip {{editPlanForm.ownerKey === 'me' ? 'active' : ''}}" data-owner="me" bindtap="chooseEditPlanOwner">
                <image class="filter-avatar green" src="{{avatarUrl}}" mode="aspectFill"></image>
                <text>我</text>
              </view>
              <view class="plan-owner-chip {{editPlanForm.ownerKey === 'partner' ? 'active' : ''}}" data-owner="partner" bindtap="chooseEditPlanOwner">
                <image class="filter-avatar blue" src="{{partnerAvatarUrl}}" mode="aspectFill"></image>
                <text>{{partnerNickname}}</text>
              </view>
            </view>
          </block>

          <view class="plan-form-label">主题标签</view>
          <view class="tag-scroll-wrap">
            <view class="tag-scroll-fade tag-scroll-fade-left {{showPlanTagScrollFadeLeft ? 'is-visible' : ''}}"></view>
            <scroll-view
              class="tag-scroll"
              scroll-x
              enhanced
              show-scrollbar="{{false}}"
              enable-flex
              bindscroll="onPlanTagScroll"
            >
              <view class="tag-scroll-list">
                <view
                  wx:for="{{quickTags}}"
                  wx:key="id"
                  class="plan-tag-option"
                  data-tag="{{item.name}}"
                  data-tag-id="{{item.id}}"
                  bindtap="chooseEditPlanTag"
                >
                  <plan-tag-pill
                    name="{{item.name}}"
                    color="{{item.color}}"
                    size="md"
                    active="{{editPlanForm.tagId === item.id}}"
                  />
                </view>
              </view>
            </scroll-view>
            <view class="tag-scroll-trail">
              <view class="tag-scroll-fade tag-scroll-fade-right {{showPlanTagScrollFadeRight ? 'is-visible' : ''}}"></view>
              <view class="plan-tag-add" bindtap="openTagCreateSheet">+</view>
            </view>
          </view>

          <view class="plan-form-label">备注</view>
          <textarea class="plan-form-textarea" value="{{editPlanForm.remark}}" data-field="remark" placeholder="补充计划细节" bindinput="onEditPlanInput" />

          <view class="plan-form-label">日期</view>
          <view class="plan-picker-field" bindtap="openDatePicker">
            <text class="plan-picker-value">{{editPlanForm.date}}</text>
            <text class="plan-picker-action">选择日期</text>
          </view>

          <view class="plan-form-label">计划性质</view>
          <view class="schedule-kind-list">
            <view
              wx:for="{{scheduleKindOptions}}"
              wx:key="key"
              class="schedule-kind-card card {{editPlanForm.scheduleKind === item.key ? 'active' : ''}}"
              data-kind="{{item.key}}"
              bindtap="chooseScheduleKind"
            >
              <view class="schedule-kind-title">{{item.title}}</view>
              <view class="schedule-kind-desc">{{item.desc}}</view>
            </view>
          </view>

          <view class="plan-schedule-detail">
          <block wx:if="{{editPlanForm.scheduleKind === 'timed'}}">
            <view class="plan-time-row">
              <view class="plan-time-item">
                <view class="plan-form-label">开始时间</view>
                <view class="plan-picker-field" bindtap="openStartTimePicker">
                  <text class="plan-picker-value plan-picker-value-time">{{editPlanForm.startTime}}</text>
                  <text class="plan-picker-action">选择</text>
                </view>
              </view>
              <view class="plan-time-item">
                <view class="plan-form-label">结束时间</view>
                <view class="plan-picker-field" bindtap="openEndTimePicker">
                  <text class="plan-picker-value plan-picker-value-time">{{editPlanForm.endTime}}</text>
                  <text class="plan-picker-action">选择</text>
                </view>
              </view>
            </view>
          </block>

          <block wx:elif="{{editPlanForm.scheduleKind === 'period'}}">
            <view class="plan-form-label">时段</view>
            <view class="plan-picker-field" bindtap="openPeriodPicker">
              <text class="plan-picker-value">{{periodOptionLabels[editPlanForm.periodIndex]}}</text>
              <text class="plan-picker-action">选择时段</text>
            </view>
          </block>

          <block wx:else>
            <view class="schedule-allday-card card">
              <view class="schedule-allday-title">全天计划</view>
              <view class="schedule-allday-desc">将显示在日计划右侧「全天」列，不占用具体时段。</view>
            </view>
          </block>
          </view>
        </view>
      </scroll-view>

      <view class="plan-action-footer">
        <button class="plan-action-btn primary-button" bindtap="savePlanEdit">保存修改</button>
        <button class="plan-action-btn secondary-button" bindtap="closePlanEdit">返回</button>
      </view>
    </block>
  </view>
</view>

<view wx:if="{{isPickerSheetVisible}}" class="plan-picker-sheet-mask mask-fade {{isPickerSheetClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="closePickerSheet" catchtouchmove="noop">
  <view class="plan-picker-sheet panel-slide {{isPickerSheetClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="noop">
    <view class="plan-picker-sheet-header">
      <text class="plan-picker-sheet-btn" bindtap="closePickerSheet">取消</text>
      <text class="plan-picker-sheet-title">{{pickerSheetTitle}}</text>
      <text class="plan-picker-sheet-btn confirm" bindtap="confirmPickerSheet">确定</text>
    </view>

    <picker-view
      wx:if="{{pickerSheetKind === 'date'}}"
      class="plan-picker-wheel"
      style="{{pageFontStyle}}"
      value="{{pickerTempValue}}"
      bindchange="onPickerSheetChange"
      indicator-class="plan-picker-indicator"
    >
      <picker-view-column>
        <view wx:for="{{pickerYears}}" wx:key="*this" class="plan-picker-option">{{item}}年</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{pickerMonths}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{pickerDayOptions}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
    </picker-view>

    <picker-view
      wx:elif="{{pickerSheetKind === 'time-start' || pickerSheetKind === 'time-end'}}"
      class="plan-picker-wheel"
      style="{{pageFontStyle}}"
      value="{{pickerTempValue}}"
      bindchange="onPickerSheetChange"
      indicator-class="plan-picker-indicator"
    >
      <picker-view-column>
        <view wx:for="{{pickerHours}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
      <picker-view-column>
        <view wx:for="{{pickerMinutes}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
    </picker-view>

    <picker-view
      wx:else
      class="plan-picker-wheel"
      style="{{pageFontStyle}}"
      value="{{pickerTempValue}}"
      bindchange="onPickerSheetChange"
      indicator-class="plan-picker-indicator"
    >
      <picker-view-column>
        <view wx:for="{{periodOptionLabels}}" wx:key="*this" class="plan-picker-option">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>
</view>

<tag-create-sheet visible="{{isTagCreateVisible}}" pageFontStyle="{{pageFontStyle}}" bind:close="closeTagCreateSheet" bind:confirm="onTagCreateConfirm" />
</view>
