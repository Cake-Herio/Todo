<font-page-meta id="font-page-meta" />
<template name="calendarGrid">
  <view class="calendar-card card">
    <view class="weekday-row">
      <view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view>
    </view>

    <view class="day-grid">
      <view
        wx:for="{{days}}"
        wx:key="date"
        class="day-cell {{item.muted ? 'muted-day' : ''}} {{item.selected ? 'selected' : ''}} {{item.hasItems ? '' : 'empty-day'}}"
        data-date="{{item.date}}"
        bindtap="goDay"
      >
        <view class="day-top">
          <text class="day-number">{{item.day}}</text>
          <text wx:if="{{item.more}}" class="mini-more-badge">+{{item.more}}</text>
        </view>
        <view wx:if="{{item.hasItems}}" class="mini-plans">
          <view wx:for="{{item.plans}}" wx:key="id" wx:for-item="plan" class="mini-plan {{plan.tone}}">
            <image class="mini-avatar {{plan.tone === 'gray' ? 'gray' : plan.tone}}" src="{{plan.avatarUrl}}" mode="aspectFill"></image>
            <plan-tag-pill name="{{plan.tag}}" size="xs-compact" ext-class="mini-plan-tag" />
            <image wx:if="{{showPlanChecks && plan.isCompleted}}" class="mini-check" src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<view class="calendar-page-root" style="{{pageFontStyle}}">
  <view class="page calendar-page" style="padding-top: {{safeTopPx}}px;">
    <view class="page-top-header">
      <view class="page-top-title">日历</view>
    </view>

    <view class="calendar-shell">
    <view class="calendar-header">
      <button class="month-button prev" data-offset="-1" bindtap="changeMonth">‹</button>
      <view bindtap="openMonthPicker">
        <view class="month-title">{{monthTitle}}</view>
        <view class="muted">{{calendarHint}}</view>
      </view>
      <button class="month-button next" data-offset="1" bindtap="changeMonth">›</button>
    </view>

    <owner-filter-bar filters="{{filters}}" activeFilter="{{activeFilter}}" bind:change="setFilter" />

    <view class="calendar-view-switch-wrap">
      <view class="calendar-view-switch">
        <view class="calendar-view-switch-thumb {{viewMode === 'completed' ? 'is-right' : ''}}"></view>
        <view
          class="calendar-view-switch-item {{viewMode === 'plan' ? 'active' : ''}}"
          data-mode="plan"
          bindtap="switchViewMode"
        >
          <image
            class="calendar-view-switch-icon"
            src="{{viewMode === 'plan' ? '/images/icons/switch-plan-white.svg' : '/images/tabbar/calendar.svg'}}"
            mode="aspectFit"
          ></image>
          <text>计划</text>
        </view>
        <view
          class="calendar-view-switch-item {{viewMode === 'completed' ? 'active' : ''}}"
          data-mode="completed"
          bindtap="switchViewMode"
        >
          <image
            class="calendar-view-switch-icon"
            src="{{viewMode === 'completed' ? '/images/icons/switch-completed-white.svg' : '/images/tabbar/completed.svg'}}"
            mode="aspectFit"
          ></image>
          <text>完成</text>
        </view>
      </view>
    </view>

    <swiper
      class="calendar-swipe-area calendar-swiper"
      current="{{swiperCurrent}}"
      duration="{{viewSwitchDuration}}"
      skip-hidden-item-layout="{{false}}"
      bindchange="onCalendarSwiperChange"
    >
      <swiper-item class="calendar-swiper-item">
        <view class="calendar-swiper-slide">
          <template is="calendarGrid" data="{{weekdays: weekdays, days: planDays, showPlanChecks: true}}" />
        </view>
      </swiper-item>
      <swiper-item class="calendar-swiper-item">
        <view class="calendar-swiper-slide">
          <template is="calendarGrid" data="{{weekdays: weekdays, days: completedDays, showPlanChecks: false}}" />
        </view>
      </swiper-item>
    </swiper>
    </view>
  </view>

  <view
    wx:if="{{isMonthPickerVisible}}"
    class="picker-mask mask-fade {{isMonthPickerClosing ? 'is-closing' : ''}}"
    style="{{pageFontStyle}}"
    catchtap="closeMonthPicker"
    catchtouchmove="noop"
  >
    <view class="picker-panel panel-slide {{isMonthPickerClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="noop">
      <view class="picker-close" catchtap="closeMonthPicker">×</view>
      <view class="picker-header">
        <view class="picker-title">切换月份</view>
        <view class="muted">{{pickerYear}} 年 {{pickerMonth + 1}} 月</view>
      </view>

      <picker-view class="month-picker" style="{{pageFontStyle}}" value="{{pickerValue}}" bindchange="onPickerChange" indicator-class="picker-indicator">
        <picker-view-column>
          <view wx:for="{{years}}" wx:key="*this" class="picker-option">{{item}} 年</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{months}}" wx:key="*this" class="picker-option">{{item}}</view>
        </picker-view-column>
      </picker-view>

      <button class="picker-confirm primary-button" bindtap="confirmMonthPicker">确认切换</button>
    </view>
  </view>
</view>
