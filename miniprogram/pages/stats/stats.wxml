<page-meta page-style="{{pageFontStyle}}" />
<view class="stats-page-shell" style="{{pageFontStyle}}">
  <view class="stats-fixed-header" style="padding-top: {{safeTopPx}}px;">
    <view class="page-top-header">
      <view class="page-top-title">{{rangeLabel}}统计</view>
      <view class="muted">按标签、成员和时间范围查看</view>
    </view>
  </view>
  <scroll-view class="scroll-page stats-scroll" scroll-y type="list">
    <view
      class="page stats-page"
      style="padding-top: calc({{safeTopPx}}px + 112rpx);"
      bindtouchstart="onSwipeStart"
      bindtouchend="onSwipeEnd"
    >
      <view class="stats-range-switch-wrap">
        <view class="stats-range-switch">
          <view class="stats-range-switch-thumb" style="transform: translateX({{rangeIndex * 100}}%);"></view>
          <view
            wx:for="{{rangeOptions}}"
            wx:key="key"
            class="stats-range-switch-item {{statsRange === item.key ? 'active' : ''}}"
            data-range="{{item.key}}"
            bindtap="switchStatsRange"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <view class="stats-period-nav">
        <button class="period-button prev" data-offset="-1" bindtap="changePeriod">‹</button>
        <view class="period-main" bindtap="goToCurrentPeriod">
          <view class="period-title">{{periodTitle}}</view>
          <view class="muted period-hint">{{periodHint}}</view>
        </view>
        <button class="period-button next {{canGoNextPeriod ? '' : 'disabled'}}" data-offset="1" bindtap="changePeriod">›</button>
      </view>

      <owner-filter-bar filters="{{filters}}" activeFilter="{{activeFilter}}" bind:change="setFilter" />
      <view class="stats-tag-filter">
        <view class="stats-tag-filter-bar">
          <view class="stats-tag-filter-btn" bindtap="openTagFilterSheet">
            <text class="stats-tag-filter-btn-text">筛选标签</text>
            <text class="stats-tag-filter-chevron">▾</text>
          </view>
          <view class="stats-tag-filter-echo-wrap">
            <view class="tag-scroll-wrap stats-tag-echo-scroll-wrap">
              <view class="tag-scroll-fade tag-scroll-fade-left stats-tag-echo-fade-left {{showTagEchoFadeLeft ? 'is-visible' : ''}}"></view>
              <scroll-view
                class="tag-scroll stats-tag-echo-scroll"
                scroll-x
                enhanced
                show-scrollbar="{{false}}"
                enable-flex
                bindscroll="onTagEchoScroll"
              >
                <view class="tag-scroll-list stats-tag-echo-list">
                  <block wx:if="{{selectedTagEcho.length}}">
                    <plan-tag-pill
                      wx:for="{{selectedTagEcho}}"
                      wx:key="tag"
                      name="{{item.tag}}"
                      color="{{item.color}}"
                      size="sm"
                    />
                  </block>
                  <text wx:else class="stats-tag-echo-placeholder muted">{{tagFilterEchoText}}</text>
                </view>
              </scroll-view>
              <view class="tag-scroll-fade tag-scroll-fade-right stats-tag-echo-fade-right {{showTagEchoFadeRight ? 'is-visible' : ''}}"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="stats-grid">
        <view wx:for="{{cards}}" wx:key="label" class="stats-metric-card">
          <view class="stats-metric-icon-wrap">
            <image class="stats-metric-icon" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          <view class="stats-metric-value">{{item.value}}</view>
          <view class="stats-metric-label">{{item.label}}</view>
        </view>
      </view>

      <view class="section-title">标签占比</view>
      <view class="chart-card chart-card-pie card">
        <view class="chart-panel">
          <view class="chart-canvas">
            <ec-canvas id="pie-chart" canvas-id="stats-pie" ec="{{pieEc}}" class="chart-ec-canvas"></ec-canvas>
          </view>
          <image class="chart-center-tree" src="/images/home/hero-tree.png" mode="aspectFit"></image>
        </view>
      </view>

      <view class="section-title">时段分布</view>
      <view class="chart-card chart-card-bar card">
        <view class="chart-panel">
          <view class="chart-canvas">
            <ec-canvas id="bar-chart" canvas-id="stats-bar" ec="{{barEc}}" class="chart-ec-canvas"></ec-canvas>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view
    wx:if="{{isTagFilterSheetVisible}}"
    class="tag-filter-mask mask-fade {{isTagFilterSheetClosing ? 'is-closing' : ''}}"
    style="{{pageFontStyle}}"
    catchtap="closeTagFilterSheet"
    catchtouchmove="noop"
  >
    <view class="tag-filter-panel panel-pop {{isTagFilterSheetClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="noop">
      <view class="tag-filter-panel-header">
        <view class="tag-filter-panel-title">筛选标签</view>
        <text class="tag-filter-sheet-toggle" catchtap="toggleSelectAllTags">{{tagFilterToggleLabel}}</text>
      </view>

      <scroll-view class="tag-filter-panel-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{tagFilterItems.length}}" class="tag-filter-grid">
          <view
            wx:for="{{tagFilterItems}}"
            wx:key="tag"
            class="tag-filter-item {{item.checked ? 'checked' : ''}}"
            catchtap="toggleTagFilter"
            data-tag="{{item.tag}}"
          >
            <plan-tag-pill name="{{item.tag}}" color="{{item.color}}" size="sm" active="{{item.checked}}" />
            <view class="tag-filter-item-check {{item.checked ? 'is-checked' : ''}}">
              <text wx:if="{{item.checked}}" class="tag-filter-item-check-icon">✓</text>
            </view>
          </view>
        </view>
        <view wx:else class="stats-empty muted tag-filter-sheet-empty">当前周期暂无可筛选标签</view>
      </scroll-view>
    </view>
  </view>
</view>
