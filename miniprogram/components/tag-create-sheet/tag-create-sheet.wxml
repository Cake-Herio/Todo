<view wx:if="{{shouldShow}}" class="tag-create-mask mask-fade {{isClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtouchmove="noop">
  <view class="tag-create-panel panel-pop {{isClosing ? 'is-closing' : ''}}" catchtap="noop">
    <view class="tag-create-header">
      <view>
        <view class="tag-create-title">新增主题</view>
        <view class="tag-create-subtitle">设置名称和颜色</view>
      </view>
      <view class="tag-create-close" catchtap="closeSheet">×</view>
    </view>

    <view class="tag-create-label">主题名称</view>
    <input
      class="tag-create-input"
      value="{{tagName}}"
      maxlength="12"
      placeholder="例如：冥想"
      bindinput="onTagNameInput"
    />

    <view class="tag-create-label">颜色</view>
    <view class="tag-color-preview-row">
      <view class="tag-color-preview" style="background: {{tagColor}};"></view>
      <input
        class="tag-color-hex-input"
        value="{{tagColor}}"
        maxlength="7"
        placeholder="#98C6A8"
        bindinput="onHexInput"
      />
    </view>

    <view class="tag-color-palette">
      <view
        wx:for="{{paletteColors}}"
        wx:key="*this"
        class="tag-color-swatch {{tagColor === item ? 'active' : ''}}"
        style="background: {{item}};"
        data-color="{{item}}"
        catchtap="choosePaletteColor"
      ></view>
    </view>

    <view class="tag-create-label">色相</view>
    <view class="tag-hue-slider-wrap">
      <slider
        class="tag-hue-slider"
        min="0"
        max="360"
        step="1"
        value="{{hueValue}}"
        activeColor="{{tagColor}}"
        backgroundColor="#E4F2E9"
        block-size="22"
        bindchanging="onHueChanging"
        bindchange="onHueChange"
      />
    </view>

    <view class="tag-create-actions">
      <button class="tag-create-cancel secondary-button" catchtap="closeSheet">取消</button>
      <button class="tag-create-confirm primary-button" catchtap="confirmSheet">添加</button>
    </view>
  </view>
</view>
