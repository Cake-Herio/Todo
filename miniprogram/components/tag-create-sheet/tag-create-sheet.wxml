<view wx:if="{{shouldShow}}" class="tag-create-mask mask-fade {{isClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtouchmove="noop">
  <view class="tag-create-panel panel-pop {{isClosing ? 'is-closing' : ''}}" style="{{pageFontStyle}}" catchtap="noop">
    <view class="tag-create-header">
      <view>
        <view class="tag-create-title">{{isEditMode ? '修改主题' : '新增主题'}}</view>
        <view class="tag-create-subtitle">{{isEditMode ? '更新名称和颜色' : '设置名称和颜色'}}</view>
      </view>
      <view class="tag-create-close" catchtap="closeSheet">×</view>
    </view>

    <view class="tag-create-label">主题名称</view>
    <input
      class="tag-create-input"
      value="{{tagName}}"
      maxlength="12"
      placeholder="例如：冥想"
      bindinput="onTagNameInput"
    />

    <block wx:if="{{showVisibilityPicker && !isEditMode}}">
      <view class="tag-create-label">标签类型</view>
      <view class="tag-visibility-switch-wrap">
        <view class="tag-visibility-switch">
          <view class="tag-visibility-switch-thumb {{tagVisibility === 'private' ? 'is-right' : ''}}"></view>
          <view
            class="tag-visibility-switch-item {{tagVisibility === 'shared' ? 'active' : ''}}"
            data-visibility="shared"
            catchtap="chooseVisibility"
          >
            共用标签
          </view>
          <view
            class="tag-visibility-switch-item {{tagVisibility === 'private' ? 'active' : ''}}"
            data-visibility="private"
            catchtap="chooseVisibility"
          >
            私人标签
          </view>
        </view>
      </view>
    </block>

    <view class="tag-create-label">颜色</view>
    <view class="tag-color-preview-row">
      <view class="tag-color-preview" style="background: {{tagColor}};"></view>
      <input
        class="tag-color-hex-input"
        value="{{tagColor}}"
        maxlength="7"
        placeholder="#98C6A8"
        bindinput="onHexInput"
      />
    </view>

    <view class="tag-color-palette">
      <view
        wx:for="{{paletteColors}}"
        wx:key="*this"
        class="tag-color-swatch {{tagColor === item ? 'active' : ''}}"
        style="background: {{item}};"
        data-color="{{item}}"
        catchtap="choosePaletteColor"
      ></view>
    </view>

    <view class="tag-create-label">色相</view>
    <view class="tag-hue-slider-wrap">
      <slider
        class="tag-hue-slider"
        min="0"
        max="360"
        step="1"
        value="{{hueValue}}"
        activeColor="transparent"
        backgroundColor="transparent"
        block-color="#FFFFFF"
        block-size="22"
        bindchanging="onHueChanging"
        bindchange="onHueChange"
      />
    </view>

    <view class="tag-create-actions">
      <button
        wx:if="{{isEditMode}}"
        class="tag-create-delete danger-button"
        catchtap="deleteSheet"
      >删除标签</button>
      <button
        wx:else
        class="tag-create-cancel secondary-button"
        catchtap="closeSheet"
      >取消</button>
      <button class="tag-create-confirm primary-button" catchtap="confirmSheet">{{isEditMode ? '保存' : '添加'}}</button>
    </view>
  </view>
</view>
