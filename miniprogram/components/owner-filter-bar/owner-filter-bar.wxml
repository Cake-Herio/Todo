<view class="owner-filter-row">
  <view wx:if="{{pinnedFilter}}" class="owner-filter-pinned">
    <view
      class="filter-chip avatar-filter {{activeFilter === pinnedFilter.key ? 'active' : ''}}"
      data-filter="{{pinnedFilter.key}}"
      bindtap="onFilterTap"
    >
      <view class="filter-avatars">
        <image
          wx:for="{{pinnedFilter.avatars}}"
          wx:key="key"
          wx:for-item="avatar"
          class="filter-avatar {{avatar.key === 'partner' ? 'blue' : 'green'}}"
          src="{{avatar.url}}"
          mode="aspectFill"
        ></image>
      </view>
      <text class="filter-label">{{pinnedFilter.label}}</text>
    </view>
  </view>

  <view class="owner-filter-scroll-wrap {{pinnedFilter ? '' : 'is-full'}}">
    <view class="owner-filter-scroll-fade owner-filter-scroll-fade-left {{showFilterScrollFadeLeft ? 'is-visible' : ''}}"></view>
    <scroll-view
      class="owner-filter-scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
      enable-flex
      bindscroll="onFilterScroll"
    >
      <view class="owner-filter-scroll-list">
        <view
          wx:for="{{scrollFilters}}"
          wx:key="key"
          class="filter-chip avatar-filter {{activeFilter === item.key ? 'active' : ''}}"
          data-filter="{{item.key}}"
          bindtap="onFilterTap"
        >
          <view class="filter-avatars">
            <image
              wx:for="{{item.avatars}}"
              wx:key="key"
              wx:for-item="avatar"
              class="filter-avatar {{avatar.key === 'partner' ? 'blue' : 'green'}}"
              src="{{avatar.url}}"
              mode="aspectFill"
            ></image>
          </view>
          <text class="filter-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="owner-filter-scroll-fade owner-filter-scroll-fade-right {{showFilterScrollFadeRight ? 'is-visible' : ''}}"></view>
  </view>
</view>
